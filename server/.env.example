# MongoDB Atlas ou instance locale
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# JWT — générer avec: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_hex_string

# Gemini (Google AI Studio → API Keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Port du serveur Express
PORT=5001

# Origines CORS autorisées (liste séparée par virgules)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
